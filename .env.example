# Plantilla de variables de entorno. COPIAR a .env y completar.
# Este archivo SÍ se sube al repo (no tiene secretos reales).

APP_NAME=Britech
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=britech_v2
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Correo (PHPMailer / SMTP). Para Gmail: usar una "App Password" (requiere 2FA).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@britech.local
MAIL_FROM_NOMBRE=Britech

# Login con Google vía Auth0 (opcional). Crear una "Regular Web Application" en
# Auth0, activar la conexión social Google, y pegar acá los datos. El
# AUTH0_COOKIE_SECRET se genera con:  openssl rand -hex 32
# Si estos quedan vacíos, el botón "Continuar con Google" avisa y no rompe nada.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_COOKIE_SECRET=
# Debe coincidir con "Allowed Callback URLs" en Auth0 (default deriva de APP_URL):
AUTH0_REDIRECT_URI=http://127.0.0.1:8123/api/tienda/auth0/callback
# A dónde vuelve tras cerrar sesión (debe estar en "Allowed Logout URLs" de Auth0):
AUTH0_LOGOUT_URI=http://127.0.0.1:8123/tienda.html
# Mercado Pago (Checkout Pro) para el pago online — opcional. Sacá el Access Token
# de tu app en https://www.mercadopago.com.ar/developers (Credenciales). Usá el de
# PRUEBA (empieza con TEST-) para testear con tarjetas de prueba. Si queda vacío, el
# checkout usa el flujo manual de transferencia + comprobante. NUNCA subir a git.
MERCADOPAGO_ACCESS_TOKEN=

# Opcional: forzar el bundle de certificados TLS si tu PHP tiene un curl.cainfo
# roto (error cURL 77). Normalmente NO hace falta (usamos composer/ca-bundle).
# CURL_CA_BUNDLE=C:\laragon\etc\ssl\cacert.pem
